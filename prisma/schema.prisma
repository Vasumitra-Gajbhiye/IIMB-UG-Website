generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Track {
  DATA_SCIENCE
  ECONOMICS
}

enum Role {
  SUPER_ADMIN
  STUDENT
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ProposalFieldType {
  TEXT
  SINGLE_SELECT
  MULTI_SELECT
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  testYear  Int?
  role      Role     @default(STUDENT)
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedBlogs Blog[] @relation("BlogReviewer")
  authoredProposals Proposal[] @relation("ProposalAuthor")
  votes             ProposalVote[]
  galleryPosts      GalleryPost[]
  galleryAlbums     GalleryAlbum[]
  faqs              Faq[]          @relation("FaqAuthor")
  faqCategories     FaqCategory[]  @relation("FaqCategoryCreator")
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  track          Track
  batch          Int?
  bio            String?  @db.Text
  avatarUrl      String?
  bannerUrl      String?
  hometown       String?
  previousSchool String?
  linkedinUrl    String?
  githubUrl      String?
  twitterUrl     String?
  instagramUrl   String?
  websiteUrl     String?
  email          String?  @unique
  isListed       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  blogs          Blog[]
  resources      Resource[]
  user           User?

  @@index([track])
  @@index([isListed])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  sortOrder   Int      @default(0)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, sortOrder])
}

model Blog {
  id            String     @id @default(uuid())
  slug          String     @unique
  title         String
  excerpt       String?
  content       Json       @default("[]")
  coverImageUrl String?
  tags          String[]
  status        PostStatus @default(DRAFT)
  reviewNote    String?    @db.Text
  submittedAt   DateTime?
  publishedAt   DateTime?
  reviewedAt    DateTime?
  authorId      String
  author        Student    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?      @relation("BlogReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model FaqCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdById String?
  createdBy   User?    @relation("FaqCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  faqs        Faq[]

  @@index([sortOrder])
}

model Faq {
  id         String      @id @default(uuid())
  question   String
  answer     String      @db.Text
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId   String?
  author     User?       @relation("FaqAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId, sortOrder])
}

model Proposal {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String         @default("Untitled")
  content     Json           @default("[]")
  status      ProposalStatus @default(DRAFT)
  formSavedAt DateTime?
  publishedAt DateTime?
  closedAt    DateTime?
  closesAt    DateTime?
  createdById String
  createdBy   User           @relation("ProposalAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  fields      ProposalField[]
  votes       ProposalVote[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([createdById])
}

model ProposalField {
  id         String             @id @default(uuid())
  proposalId String
  proposal   Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  label      String
  type       ProposalFieldType
  options    String[]
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([proposalId, sortOrder])
}

model ProposalVote {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymous  Boolean  @default(false)
  answers    Json
  createdAt  DateTime @default(now())

  @@unique([proposalId, userId])
  @@index([proposalId, createdAt])
}

enum GalleryItemKind {
  IMAGE
  VIDEO
}

model GalleryPost {
  id        String        @id @default(uuid())
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items     GalleryItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([authorId, createdAt])
}

model GalleryItem {
  id          String          @id @default(uuid())
  postId      String?
  post        GalleryPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  albumId     String?
  album       GalleryAlbum?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  kind        GalleryItemKind
  key         String
  url         String
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  caption     String?         @db.Text
  takenAt     DateTime
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([takenAt])
  @@index([postId, sortOrder])
  @@index([albumId, sortOrder])
}

model GalleryAlbum {
  id        String                 @id @default(uuid())
  name      String
  authorId  String
  author    User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items     GalleryItem[]
  dateSpans GalleryAlbumDateSpan[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([authorId, createdAt])
}

model GalleryAlbumDateSpan {
  id        String       @id @default(uuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  startOn   DateTime
  endOn     DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([albumId])
  @@index([startOn, endOn])
}
